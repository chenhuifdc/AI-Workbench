# ============================================================================
# AI 工作台 配置样例
#
# 放在哪里（按优先级）：
#   1) 环境变量 AI_WORKBENCH_ENV_FILE=<绝对路径>  → 显式指定，最高优先
#   2) 打包版：把本文件复制为 .env，与 AI-Workbench.exe 放在同一目录
#      （zip 解压后 / 安装目录根下，即 exe 旁边）
#   3) 开发版：项目根目录的 .env（npm run dev / npm run electron 都读它）
#
# 至少填一个 Key，或配置好本地 OLLAMA_HOST 才能对话。
# ============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DEEPSEEK_API_KEY: Optional. For DeepSeek official API (deepseek-chat, deepseek-reasoner R1)
# Endpoint: https://api.deepseek.com/v1
DEEPSEEK_API_KEY=""

# OPENROUTER_API_KEY: Optional. For OpenRouter unified model gateway
# Endpoint: https://openrouter.ai/api/v1
OPENROUTER_API_KEY=""

# OPENAI_API_KEY: Optional. For OpenAI official API (gpt-4o, gpt-4o-mini)
# Endpoint: https://api.openai.com/v1
OPENAI_API_KEY=""

# OLLAMA_HOST: Local/LAN Ollama CPU/GPU instance for 100% offline zero-cost execution.
# Hotspot LAN IP: http://172.20.10.2:11434 | Local loopback: http://127.0.0.1:11434
OLLAMA_HOST="http://172.20.10.2:11434"
# OLLAMA_ORIGINS: Required when binding to 0.0.0.0 to allow browser web UI cross-origin requests
OLLAMA_ORIGINS="*"
